FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY pyproject.toml README.md ./
COPY trajrl_validator ./trajrl_validator
COPY spec ./spec
RUN pip install ".[chain]"
VOLUME ["/var/lib/trajrl"]
HEALTHCHECK --interval=60s --timeout=10s CMD trajrl-health
CMD ["trajrl-validator"]
